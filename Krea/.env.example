KREA_HOST=127.0.0.1
KREA_PORT=8300

# Empty for standalone/local-dev use. Set to e.g. "/Image" only when mounted
# behind the BunnyBytes gateway - both the gateway route prefix and this
# value must agree, since the frontend bakes this prefix into every
# fetch/EventSource/static-asset URL it builds (see static/js/app.js).
KREA_MOUNT_PREFIX=

# ComfyUI is a loopback-only native service on the host, managed
# independently of this app. Sibling apps (Music/Video)
# default to 8189 (ComfyUI Desktop); the instance this app's workflow was
# actually validated against live was 8188 (a manually-launched native
# ComfyUI, same install, same models). Confirm which port production expects
# before deploying - see BunnyBytes/workflows/NOTES.md.
KREA_COMFY_URL=http://127.0.0.1:8189

# bunny-lock cross-app GPU lock (127.0.0.1-only; only used when a request
# arrives via the gateway carrying an X-Lock-Token header - standalone/local
# runs never call this).
KREA_LOCK_URL=http://127.0.0.1:8600
KREA_LOCK_HEARTBEAT_INTERVAL=20

KREA_WORKFLOW_PATH=./workflows/Krea2-Advanced-LoRA-API.json

# MOSS-Image INT8 text encoder and VAE filenames in ComfyUI. Requires the
# MOSSImageUNETLoader and MOSSImageCLIPLoader nodes, plus the INT8 denoiser.
KREA_MOSS_WORKFLOW_PATH=./workflows/MOSS-Image-INT8-API.json
KREA_MOSS_FAST_WORKFLOW_PATH=./workflows/MOSS-Image-Few-Step-API.json
KREA_MOSS_CLIP_NAME=qwen3.5_9b_int8_convrot.safetensors
KREA_MOSS_VAE_NAME=flux2-vae.safetensors

# MUST point at the SAME directory ComfyUI's own --output-directory writes
# to, or generated images will never be found (this app only reads paths
# ComfyUI's own /history response reports, it never lists the directory).
# Absolute path of the ComfyUI output folder. Do not
# default this to a local ./Output folder unless ComfyUI is actually
# configured to write there.
KREA_OUTPUT_DIR=/path/to/ComfyUI/output
KREA_DATA_DIR=./data
KREA_LOG_DIR=./logs
KREA_MONITOR_INTERVAL=2
