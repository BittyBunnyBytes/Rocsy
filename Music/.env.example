MUS_HOST=127.0.0.1
MUS_PORT=8200

# Empty for standalone/local-dev use. Set to e.g. "/Mus" only when mounted
# behind the BunnyBytes gateway - both the gateway route prefix and this
# value must agree, since the frontend bakes this prefix into every
# fetch/EventSource/static-asset URL it builds (see static/js/app.js).
MUS_MOUNT_PREFIX=

# ComfyUI is a loopback-only native service on the host, managed
# independently of this app. The production instance runs on 127.0.0.1:8188.
MUS_COMFY_URL=http://127.0.0.1:8188

# bunny-lock cross-app GPU lock (127.0.0.1-only; only used when a request
# arrives via the gateway carrying an X-Lock-Token header - standalone/local
# runs never call this).
MUS_LOCK_URL=http://127.0.0.1:8600
MUS_LOCK_HEARTBEAT_INTERVAL=20

MUS_WORKFLOW_PATH=./workflows/YuE2-INT8.json
MUS_MINIMAX_WORKFLOW_PATH=./workflows/MiniMax-Music3-INT8.json
MUS_MODELS_DIR=/path/to/ComfyUI/models
# MUST point at the SAME directory ComfyUI's own --output-directory writes
# to, or generated files will never be found (this app only reads paths
# ComfyUI's own /history response reports, it never lists the directory).
# Absolute path of the ComfyUI output folder.
MUS_OUTPUT_DIR=/path/to/ComfyUI/output
MUS_DATA_DIR=./data
MUS_LOG_DIR=./logs
MUS_MONITOR_INTERVAL=2
