H3_HOST=0.0.0.0
H3_PORT=8000

# run.sh starts the existing named Cloudflare tunnel for https://rocsy.example.com.
H3_CLOUDFLARE_ENABLED=1
H3_CLOUDFLARE_TUNNEL=rocsy
H3_CLOUDFLARE_ORIGIN=http://127.0.0.1:8000

# External services are checked and called, never terminated.
H3_COMFY_URL=http://127.0.0.1:8188
H3_COMFY_MODE=external
H3_COMFY_COMMAND=
H3_QWEN_URL=http://127.0.0.1:8081/v1
H3_QWEN_MODE=external
H3_QWEN_COMMAND=./config/server_command.txt

H3_WORKFLOW_PATH=./workflows/MiniMax-H3.json
H3_LTX_WORKFLOW_PATH=./workflows/LTX-2.5-Final-Optimized.json
H3_UPLOAD_DIR=./uploads
H3_INPUT_DIR=./input
# MUST point at the SAME directory ComfyUI's own --output-directory writes
# to, or generated files will never be found (this app only reads paths
# ComfyUI's own /history response reports, it never lists the directory).
# Absolute path of the ComfyUI output folder H3 renders land in.
H3_OUTPUT_DIR=/path/to/ComfyUI/output
H3_DATA_DIR=./data
H3_LOG_DIR=./logs
H3_PROMPT_GUIDE=./Official-H3-Prompting-Guidelines.md
H3_MAX_UPLOAD_MB=20
H3_MONITOR_INTERVAL=2
