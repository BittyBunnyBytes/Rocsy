# Copy this file to .env and fill in real values before `docker compose up`.
# This is the ONE shared .env for cross-cutting secrets/config that must stay
# consistent across services. Each app also has its own .env.example
# documenting its own knobs, but the values below are what this top-level
# docker-compose.yml actually passes through as environment: entries.

# --- Gateway auth (required, no defaults - the gateway refuses to start
# without these) ---
# The single shared password that unlocks the whole site. Choose something
# long and random - this is the one credential standing between the public
# internet and your GPU. Leave blank here (like COOKIE_SECRET below) - this
# file is a template, not a secrets store.
MASTER_PASSWORD=

# Random secret used to sign the session cookie (HMAC key, not a password).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
COOKIE_SECRET=

# Shared secret gating the GPU queue coordinator's internal surface
# (/enqueue, /heartbeat, /release, /dequeue, PATCH /queue) - every app and
# the lock service itself must have the same value. Generate one the same
# way as COOKIE_SECRET above.
QUEUE_INTERNAL_SECRET=

# Shared secret between the containers and the host helper (hostctl, port 8899) behind
# Settings → Services. Generate it the same way; install-units.sh copies it into
# hostctl/hostctl.env for the bunny-hostctl unit.
HOSTCTL_SECRET=

# --- Public address ---
# The URL people open Rocsy at (e.g. https://rocsy.example.com), or a mailto: address.
# Browser push services use it as the contact for notifications. Optional.
ROCSY_PUBLIC_URL=

# --- Cloudflare tunnel ---
CLOUDFLARE_TUNNEL_NAME=rocsy

# --- Per-app ports (host-network binds; must not collide with each other or
# anything else already running on this host) ---
GATEWAY_PORT=8080
LOCK_PORT=8600
H3_PORT=8000
MUS_PORT=8200
KREA_PORT=8300
LLAMA_PORT=8400
TRAINER_PORT=8500
VOICE_PORT=8950

# --- Upstreams the gateway proxies to (must match the ports above) ---
VID_UPSTREAM=http://127.0.0.1:8000
MUS_UPSTREAM=http://127.0.0.1:8200
KREA_UPSTREAM=http://127.0.0.1:8300
LOCK_URL=http://127.0.0.1:8600
QUEUE_UPSTREAM=http://127.0.0.1:8600
LLAMA_UPSTREAM=http://127.0.0.1:8400
TRAINER_UPSTREAM=http://127.0.0.1:8500

# --- llama.cpp / llama-swap (see ../Llama) ---
# Bearer key required on /Llama/* -- both by llama-swap itself (apiKeys: in
# Llama/config.yaml) and by the gateway (accepted as an alternative to a
# logged-in browser session, since headless callers like Hermes agents can't
# do the cookie-login flow). Generate one the same way as COOKIE_SECRET above,
# then give the same value to any Hermes agent that should reach this
# endpoint (as a model_alias's api_key/key_env in its config.yaml).
LLAMA_API_KEY=

# Optional llama.cpp GPU placement and offload controls. GPU 0 is always first.
# Example for two GPUs: LLAMA_GPU_DEVICES=ROCm0,ROCm1
LLAMA_GPU_DEVICES=ROCm0
# layer (default), row, tensor, or none. "none" uses GPU 0 only.
LLAMA_SPLIT_MODE=layer
# Relative model shares in device order, e.g. 3,1; blank lets llama.cpp decide.
LLAMA_TENSOR_SPLIT=
# Exact number, all, or auto. Blank keeps each model's current default.
LLAMA_GPU_LAYERS=
# Reserve MiB per GPU for automatic fit: e.g. 4096,2048. Blank keeps defaults.
LLAMA_FIT_TARGET=
# Keep this many initial MoE expert layers on CPU; blank keeps default.
LLAMA_CPU_MOE_LAYERS=
# 1 offloads KV cache to GPU, 0 keeps it on CPU.
LLAMA_KV_OFFLOAD=1

# --- Native services on this host (NOT dockerized - GPU workloads stay
# bare-metal; only the lightweight web-wrapper apps above are containerized).
# Confirmed on this host: ComfyUI Desktop runs on 8189 (not the engine's own
# 8188 default), Qwen normally on 8081. Both are loopback-only. ---
COMFY_URL=http://127.0.0.1:8189
QWEN_BASE_URL=http://127.0.0.1:8081/v1

# --- Folders (absolute paths; the installer fills these in) ---
# docker-compose.yml has no machine paths of its own: everything outside this checkout
# comes from here. Personal extras (more model folders, game folders for REA) go in
# docker-compose.override.yml - see docker-compose.override.example.yml.
# ROCSY_ROOT: the folder that holds BunnyBytes/, Video/, Llama/ ... (this checkout).
# The llama.cpp builds live under it (llama.cpp-builds/, llama.cpp-rdna-boost/).
ROCSY_ROOT=
# Your ComfyUI folder (the one with models/, input/, output/).
ROCSY_COMFY_ROOT=
# Optional older shared ComfyUI folder for the Telegram watcher; empty = ROCSY_COMFY_ROOT.
ROCSY_COMFY_SHARED=
# Hermes' home (config, skills, the agent's workspace); empty = ~/.hermes.
ROCSY_HERMES_HOME=
