@@ -325,6 +325,31 @@ def _native_screenshot_result(result: dict[str, Any], path: str) -> Optional[dic
         return None
 
 
+def _rocsy_screenshot(path: str) -> str:
+    """Rocsy: a copy of this call's screenshot in the Rocsy workspace, for the chat to show ("" when this
+    Hermes isn't Rocsy's). The copy keeps the chat's picture after the harness overwrites its shot.png;
+    copies older than a day are removed."""
+    workspace = Path(get_hermes_home()) / "rocsy-workspace"
+    if not workspace.is_dir():
+        return ""
+    import shutil
+    import uuid
+    folder = workspace / ".browser-screenshots"
+    try:
+        folder.mkdir(parents=True, exist_ok=True)
+        cutoff = time.time() - 24 * 3600
+        for old in folder.glob("page-*"):
+            with contextlib.suppress(OSError):
+                if old.stat().st_mtime < cutoff:
+                    old.unlink()
+        target = folder / f"page-{uuid.uuid4().hex}{Path(path).suffix or '.png'}"
+        shutil.copyfile(path, target)
+        return str(target)
+    except OSError as exc:
+        logger.debug("Rocsy page screenshot copy failed: %s", exc)
+        return ""
+
+
