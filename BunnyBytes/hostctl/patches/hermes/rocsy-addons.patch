@@ -0,0 +1,27 @@
+"""Rocsy: browser_exec's screenshot is copied into the Rocsy workspace for the chat (and only there)."""
+import os
+import time
+
+import tools.browser_use_cli as cli
+
+
+def test_copied_into_the_rocsy_workspace(tmp_path, monkeypatch):
+    monkeypatch.setattr(cli, "get_hermes_home", lambda: str(tmp_path))
+    (tmp_path / "rocsy-workspace").mkdir()
+    shot = tmp_path / "shot.png"
+    shot.write_bytes(b"png")
+    old = tmp_path / "rocsy-workspace/.browser-screenshots"
+    old.mkdir()
+    stale = old / "page-old.png"
+    stale.write_bytes(b"x")
+    os.utime(stale, (time.time() - 2 * 86400,) * 2)
+    copy = cli._rocsy_screenshot(str(shot))
+    assert copy.startswith(str(old)) and copy.endswith(".png") and open(copy, "rb").read() == b"png"
+    assert not stale.exists()
+
+
+def test_nothing_without_a_rocsy_workspace(tmp_path, monkeypatch):
+    monkeypatch.setattr(cli, "get_hermes_home", lambda: str(tmp_path))
+    shot = tmp_path / "shot.jpg"
+    shot.write_bytes(b"jpg")
+    assert cli._rocsy_screenshot(str(shot)) == ""
